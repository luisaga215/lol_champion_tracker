# Riot Games Developer API key (https://developer.riotgames.com)
RIOT_API_KEY=RGAPI-f43bdb33-cabf-4278-858d-44675afc00a3

# Regional routing for match-v5 (AMERICAS / EUROPE / ASIA / SEA)
RIOT_BASE_URL=https://americas.api.riotgames.com

# SQLite database location
DATABASE_PATH=data/arena_pipeline.db

# Arena queue ids
QUEUE_IDS=[1700, 1710]

# Crawler tuning
CRAWLER_CONCURRENCY=5
CRAWLER_MAX_MATCHES_PER_SEED=100
CRAWLER_MATCH_HISTORY_COUNT=100
CRAWLER_SEED_PUUIDS=[]

# Background scheduler (crawl + aggregate loop inside the API process)
SCHEDULER_ENABLED=false
CRAWLER_INTERVAL_SECONDS=900

# API binding
API_HOST=0.0.0.0
API_PORT=8000
